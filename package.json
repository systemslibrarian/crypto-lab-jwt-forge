{
  "name": "crypto-lab-jwt-forge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A JWT/JWS security playground: alg:none and key-confusion attacks, with a Correct vs Vulnerable verifier contrast.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:a11y": "playwright test",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run build && gh-pages -d dist"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "gh-pages": "^6.3.0",
    "happy-dom": "^20.11.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
